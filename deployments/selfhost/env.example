# Biplane self-host configuration.
# Copy to .env beside the compose files and fill every CHANGEME
# (e.g. `openssl rand -hex 24`). Values marked "keep in sync" must be
# edited together — the compose file does not derive one from the other.

# --- release / images ---------------------------------------------------
APP_RELEASE=v1.3.1
# Forked images; override to point at your registry (e.g. registry.example.com/biplane-web:v1.3.1).
# space is forked too; live and proxy intentionally run upstream images (unforked).
BIPLANE_WEB_IMAGE=biplane-web:latest
BIPLANE_ADMIN_IMAGE=biplane-admin:latest
BIPLANE_SPACE_IMAGE=biplane-space:latest
BIPLANE_BACKEND_IMAGE=biplane-backend:latest
# Written by apply-update.sh after a successful digest-pinned release apply.
# Leave blank on an initial/manual install: the command reads the release tag
# baked into the running backend image and refuses if neither source is known.
BIPLANE_APPLIED_RELEASE=

# --- network (keep in sync: APP_DOMAIN, WEB_URL, CORS_ALLOWED_ORIGINS) ---
# Port the proxy publishes on the host; pick any free port at install time.
LISTEN_HTTP_PORT=80
LISTEN_HTTPS_PORT=443
# Domain (or host:port) your users will reach the instance at. If you change
# APP_DOMAIN or LISTEN_HTTP_PORT, change WEB_URL and CORS_ALLOWED_ORIGINS to match.
APP_DOMAIN=localhost
WEB_URL=http://localhost
CORS_ALLOWED_ORIGINS=http://localhost

# --- TLS (only if you serve HTTPS via the bundled proxy) -----------------
# Leave CERT_EMAIL and CERT_ACME_DNS empty to run plain HTTP behind your own proxy.
# When set, they are FULL Caddy global directives, not bare values — witnessed
# against plane-proxy v1.3.1 (a bare value crash-loops the proxy):
#   CERT_EMAIL=email ops@example.com
#   CERT_ACME_DNS=acme_dns cloudflare <api-token>
CERT_EMAIL=
# CERT_ACME_CA must be NON-EMPTY: the proxy Caddyfile uses {$CERT_ACME_CA:default},
# but compose always sets the var, and Caddy only applies the default when it is
# UNSET — an empty value yields a bare acme_ca directive and the proxy crash-loops.
# Harmless for plain-HTTP deployments; only used if you serve HTTPS via this proxy.
CERT_ACME_CA=https://acme-v02.api.letsencrypt.org/directory
CERT_ACME_DNS=

# --- secrets (keep in sync: passwords and the URLs that embed them) ------
SECRET_KEY=CHANGEME
LIVE_SERVER_SECRET_KEY=CHANGEME
# Postgres: POSTGRES_PASSWORD and DATABASE_URL must carry the SAME password,
# or the API/worker/migrator will authenticate with stale defaults.
POSTGRES_PASSWORD=CHANGEME
DATABASE_URL=postgresql://plane:CHANGEME@plane-db/plane
# RabbitMQ: RABBITMQ_PASSWORD and AMQP_URL must carry the SAME password.
RABBITMQ_PASSWORD=CHANGEME
AMQP_URL=amqp://plane:CHANGEME@plane-mq:5672/plane
# MinIO / S3
AWS_ACCESS_KEY_ID=CHANGEME
AWS_SECRET_ACCESS_KEY=CHANGEME
# Forgejo git bridge (optional). Set BOTH to enable. NOTE (v1.1.0, BIP-67):
# the bridge does NOT move tickets. Pushes and merged PRs whose commits or PR
# BODY reference a ticket (refs/fixes/closes ABC-123) are RECOGNISED and their
# outcome recorded durably, but no ticket changes state in any direction --
# you move the board. Earlier versions advanced to an in-progress state on
# push and a completed state on merge; that is deleted, so no state naming or
# workflow group affects the bridge any more. Changing these needs
# api/worker/beat-worker recreated. See deployments/selfhost/README.md
# "Git bridge setup".
# Secret: min 16 chars, must match the Forgejo webhook secret exactly.
FORGEJO_WEBHOOK_SECRET=
# A STABLE id for THIS Forgejo instance — it namespaces semantic event
# keys so two Forgejo servers cannot collide (ADR 010). REQUIRED once the
# secret above is set: an enabled bridge with no instance id refuses every
# delivery and fails startup. Unique per forge; changing it after events
# have arrived is a namespace migration, not a config edit.
FORGEJO_INSTANCE_ID=
# JSON object: "<provider INSTANCE id>:<stable repository id>" -> the LIST of
# project UUIDs whose work items a directive in that repo may NAME (BIP-38
# scope guard; nothing moves, so the guard is on SELECTION). The key
# PREFIX is your configured *_INSTANCE_ID value — NOT the forge family name —
# so with FORGEJO_INSTANCE_ID=pi5-forgejo and GITLAB_INSTANCE_ID=gitlab:
# {"pi5-forgejo:42":["9c1f...-uuid"],"gitlab:1337":["4a2b...-uuid"]}.
# Read the prefix from your live env; do not assume "forgejo" — a key under
# the wrong prefix grants NOTHING and fails silently-inert (200s, nothing
# recognised) apart from a loud wrong-prefix warning in the logs. The numeric
# repo id is the tenancy boundary (paths are mutable; renames would leak
# authority; ids are per-instance, so two instances sharing a number stay
# isolated); the project UUIDs are the AUTHORITY boundary — a directive
# naming any project outside the list is rejected and durably recorded in the
# delivery result. A workspace-slug value is the RETIRED pre-BIP-38 schema
# and is refused as a config defect: list the projects explicitly. A bare
# "org/repo" path KEY is Forgejo-only LEGACY: works, but warns loudly on
# every use — migrate to the id form. Project UUIDs: Plane UI project
# settings, or /api/v1/workspaces/<slug>/projects/.
FORGEJO_BRIDGE_REPO_MAP=
# Needed only if pushes can exceed the Forgejo webhook commit limit (default 15):
# lets the bridge fetch the full commit range for large pushes.
FORGEJO_BASE_URL=
FORGEJO_BRIDGE_API_TOKEN=
# Replying on a pull request is a SEPARATE grant from reading it. The bridge
# tells whoever merged why it declined to move a ticket, by commenting on their
# pull request -- and the token above is read-only, so it cannot do that. Leave
# this empty and the bridge stays silent rather than failing on every delivery.
# Grant it the minimum: comment access on the mapped repositories, nothing more.
FORGEJO_BRIDGE_WRITE_TOKEN=
# Set to 1 to accept forges whose signature does not cover the request body
# (e.g. GitLab's static token). Weaker guarantee: it proves the sender knew the
# secret, nothing about the bytes that arrived. Off by default; opt in deliberately.
BRIDGE_ALLOW_UNSIGNED_BODY_FORGES=0
# Per-forge credentials. Each MUST be a distinct value (min 16 chars); never
# reuse one across forges. GitLab sends its token back verbatim, the others
# use theirs as an HMAC key — a shared value would let anyone who observes the
# GitLab token forge signed Forgejo/GitHub deliveries, and the bridge refuses
# GitLab outright if its token equals an HMAC secret. A forge with no
# credential set is simply closed.
GITHUB_WEBHOOK_SECRET=
GITLAB_WEBHOOK_TOKEN=
# Stable per-instance ids (namespace for semantic keys, ADR 010) — REQUIRED
# for each forge whose credential above is set; unique per forge. An enabled
# forge with no instance id refuses deliveries and fails startup.
GITHUB_INSTANCE_ID=
GITLAB_INSTANCE_ID=

# biplane — the host's own name as the URLs BELOW refer to it (the Forgejo base
# URL, the apply-service URL). Those services run on the DOCKER HOST, and a
# container cannot resolve the host's name on its own — an mDNS `.local` name
# resolves on the LAN but never inside a container. The compose maps this alias
# to the docker host-gateway (extra_hosts on api + worker), so a URL like
# http://forge.example.com:3000 reaches the host from inside the container. Set it to the
# host name your URLs use (e.g. forge.example.com). Leave blank to use the docker-standard
# host.docker.internal, in which case point the URLs below at that name instead.
SELFHOST_HOST_ALIAS=

# biplane (BIP-32) — where the update check looks for OUR releases.
# Owner ruling: check our repos, never upstream Plane's. Forgejo preferred,
# our public GitHub mirror as fallback. Unreachable reports UNKNOWN, never
# "up to date".
# Forgejo base URL, e.g. http://forge.example.com:3000 . Leave blank to use GitHub only.
BIPLANE_FORGEJO_URL=
BIPLANE_FORGEJO_REPO=example/biplane
# Forgejo-only token. example/biplane is private, so without this the preferred
# source cannot answer. NEVER sent to any other host.
BIPLANE_FORGEJO_RELEASE_TOKEN=
# Our own public mirror. Never makeplane/plane.
BIPLANE_GITHUB_REPO=NetverseSocial/biplane
# Extra origins the update check may fetch from (comma-separated), UNIONED
# with the built-in defaults (GitHub API + release-asset hosts) — an extra
# origin never replaces them. The Forgejo base URL above is included
# automatically. A release's changelog link is shown to the admin only when
# it points at one of these origins.
BIPLANE_UPDATE_ALLOWED_ORIGINS=

# biplane (ticket 69) — the one-click apply. Points the server at the narrow
# privileged applier on the deploy host (deployments/selfhost/apply-service/).
# BOTH must be set or the apply endpoints answer 501 and the UI shows only
# the manual path. The URL is reached FROM INSIDE the api container — with
# the standard compose that is the host-gateway, e.g. http://forge.example.com:7671
# (with the extra_hosts host-gateway mapping) — and the token must equal the
# applier's APPLY_SERVICE_TOKEN_FILE content. Full-level releases are always
# refused by this path and take MANUAL-FULL-UPGRADE.md.
BIPLANE_APPLY_SERVICE_URL=
BIPLANE_APPLY_SERVICE_TOKEN=
# AUTOMATIC updates: "1" = when the hourly check flags a code/data release,
# the server asks the applier to install it, at most once per tag (a failed
# attempt is an operator decision to retry, never an hourly loop). Anything
# else = off; the banner and button still work. full releases are never
# auto-applied.
BIPLANE_APPLY_AUTO=

# BIPLANE_BUILD is NOT set here (BIP-36, Morrow RC 3271). It is baked into the
# backend image by deployments/selfhost/build-images.sh, so it identifies the
# code actually running. Setting it at runtime would let it disagree with the
# image, which is worse than UNKNOWN because it looks authoritative.
