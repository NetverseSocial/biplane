# Biplane self-host configuration.
# Copy to .env beside the compose files and fill every CHANGEME
# (e.g. `openssl rand -hex 24`). Values marked "keep in sync" must be
# edited together — the compose file does not derive one from the other.

# --- release / images ---------------------------------------------------
APP_RELEASE=v1.3.1
# Forked images; override to point at your registry (e.g. registry.example.com/biplane-web:v1.3.1).
# space is forked too; live and proxy intentionally run upstream images (unforked).
BIPLANE_WEB_IMAGE=biplane-web:latest
BIPLANE_ADMIN_IMAGE=biplane-admin:latest
BIPLANE_SPACE_IMAGE=biplane-space:latest
BIPLANE_BACKEND_IMAGE=biplane-backend:latest

# --- network (keep in sync: APP_DOMAIN, WEB_URL, CORS_ALLOWED_ORIGINS) ---
# Port the proxy publishes on the host; pick any free port at install time.
LISTEN_HTTP_PORT=80
LISTEN_HTTPS_PORT=443
# Domain (or host:port) your users will reach the instance at. If you change
# APP_DOMAIN or LISTEN_HTTP_PORT, change WEB_URL and CORS_ALLOWED_ORIGINS to match.
APP_DOMAIN=localhost
WEB_URL=http://localhost
CORS_ALLOWED_ORIGINS=http://localhost

# --- TLS (only if you serve HTTPS via the bundled proxy) -----------------
# Leave CERT_EMAIL and CERT_ACME_DNS empty to run plain HTTP behind your own proxy.
# When set, they are FULL Caddy global directives, not bare values — witnessed
# against plane-proxy v1.3.1 (a bare value crash-loops the proxy):
#   CERT_EMAIL=email ops@example.com
#   CERT_ACME_DNS=acme_dns cloudflare <api-token>
CERT_EMAIL=
# CERT_ACME_CA must be NON-EMPTY: the proxy Caddyfile uses {$CERT_ACME_CA:default},
# but compose always sets the var, and Caddy only applies the default when it is
# UNSET — an empty value yields a bare acme_ca directive and the proxy crash-loops.
# Harmless for plain-HTTP deployments; only used if you serve HTTPS via this proxy.
CERT_ACME_CA=https://acme-v02.api.letsencrypt.org/directory
CERT_ACME_DNS=

# --- secrets (keep in sync: passwords and the URLs that embed them) ------
SECRET_KEY=CHANGEME
LIVE_SERVER_SECRET_KEY=CHANGEME
# Postgres: POSTGRES_PASSWORD and DATABASE_URL must carry the SAME password,
# or the API/worker/migrator will authenticate with stale defaults.
POSTGRES_PASSWORD=CHANGEME
DATABASE_URL=postgresql://plane:CHANGEME@plane-db/plane
# RabbitMQ: RABBITMQ_PASSWORD and AMQP_URL must carry the SAME password.
RABBITMQ_PASSWORD=CHANGEME
AMQP_URL=amqp://plane:CHANGEME@plane-mq:5672/plane
# MinIO / S3
AWS_ACCESS_KEY_ID=CHANGEME
AWS_SECRET_ACCESS_KEY=CHANGEME
